    {
      "name": "Auth - New User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();",
              "console.log(response);",
              "pm.collectionVariables.set(\"SESSION_ID\", response?.sessionID);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.collectionVariables.set(\"USERNAME\", `player-${(Math.random()*1e12).toFixed(0)}`);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"username\": \"{{USERNAME}}\",\n    \"balance\": {{BALANCE}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{BASE_URL}}/auth",
          "host": [
            "{{BASE_URL}}"
          ],
          "path": [
            "auth"
          ]
        }
      },
      "response": []
