  "item": [
    {
      "name": "Games",
      "item": [
        {
          "name": "Mines",
          "item": [
            {
              "name": "Setup",
              "request": {
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "raw",
                  "raw": "{\n    \"sessionID\": \"{{SESSION_ID}}\",\n    \"gameID\": \"{{GAME_ID}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{BASE_URL}}/games/setup",
                  "host": [
                    "{{BASE_URL}}"
                  ],
                  "path": [
                    "games",
                    "setup"
                  ]
                }
              },
              "response": []
            },
            {
              "name": "Play",
